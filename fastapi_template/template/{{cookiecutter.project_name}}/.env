{{cookiecutter.project_name | upper}}_RELOAD=True
{{cookiecutter.project_name | upper}}_ENVIRONMENT=dev
{%- if cookiecutter.db_info.name == "sqlite" %}
{{cookiecutter.project_name | upper}}_DB_FILE=db.sqlite3
{%- elif cookiecutter.db_info.name != 'none' %}
# Host-side defaults (pytest / uv run). Inside Compose, *_DB_HOST is set to `db`.
{{cookiecutter.project_name | upper}}_DB_HOST=localhost
# Compose interpolates these for Postgres/Mongo/MySQL (override in prod/secrets).
DB_USER={{cookiecutter.project_name}}
DB_PASSWORD={{cookiecutter.project_name}}
DB_NAME={{cookiecutter.project_name}}
{%- endif %}
{%- if cookiecutter.add_users == "True" %}
USERS_SECRET=""
{%- endif %}
{%- if cookiecutter.enable_rmq == "True" %}
# guest/guest is local-dev only; set strong values for shared/prod environments.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
{%- endif %}
{%- if cookiecutter.enable_kafka == "True" %}
# Host-side (dev overlay publishes 9094). Inside Compose use kafka:9092 via compose env.
{{cookiecutter.project_name | upper}}_KAFKA_BOOTSTRAP_SERVERS='["localhost:9094"]'
{%- endif %}
{%- if cookiecutter.enable_nats == "True" %}
{{cookiecutter.project_name | upper}}_NATS_SERVERS='["nats://localhost:4222"]'
{%- endif %}
